{
  "name": "profile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "rw",
  "sourceRoot": "apps/profile/src",
  "tags": ["app:remote", "domain:profile"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/profile/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "profile:esbuild:production"
        },
        "development": {
          "target": "profile:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "profile:serve-original:development",
        "tsConfig": "apps/profile/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "buildNotifications": {
          "enable": true
        },
        "port": 4201
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "profile:esbuild:development",
        "watch": false,
        "tsConfig": "apps/profile/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "profile:build",
        "port": 4201,
        "staticFilePath": "dist/apps/profile/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/profile",
        "browser": "apps/profile/src/main.ts",
        "tsConfig": "apps/profile/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/profile/public"
          }
        ],
        "styles": ["apps/web/src/styles.css"],
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "profile:esbuild:production"
        },
        "development": {
          "buildTarget": "profile:esbuild:development"
        }
      }
    }
  }
}
