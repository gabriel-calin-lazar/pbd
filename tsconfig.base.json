{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@pbd/auth": ["./libs/auth/src/index.ts"],
      "@pbd/core": ["./libs/core/src/index.ts"],
      "@pbd/shared/photon/service": ["./libs/shared/photon/service/src/index.ts"],
      "@pbd/shared/photon/models": ["./libs/shared/photon/models/src/index.ts"],
      "@pbd/shared/components/avatar": ["./libs/shared/components/avatar/src/index.ts"],
      "@pbd/shared/components/button": ["./libs/shared/components/button/src/index.ts"],
      "@pbd/shared/components/pizza-logo": ["./libs/shared/components/pizza-logo/src/index.ts"],
      "@pbd/shared/models/adress": ["./libs/shared/models/adress/src/index.ts"],
      "@pbd/shared/pipes/catalog-image-url": ["./libs/shared/pipes/catalog-image-url/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
