{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@pbd/auth": ["./libs/auth/src/index.ts"],
      "@pbd/core": ["./libs/core/src/index.ts"],
      "@pbd/cart-store": ["./libs/cart-store/src/index.ts"],
      "@pbd/shared/photon/service": ["./libs/shared/photon/service/src/index.ts"],
      "@pbd/shared/photon/models": ["./libs/shared/photon/models/src/index.ts"],
      "@pbd/shared/directives/role": ["./libs/shared/directives/role/src/index.ts"],
      "@pbd/shared/components/avatar": ["./libs/shared/components/avatar/src/index.ts"],
      "@pbd/shared/components/button": ["./libs/shared/components/button/src/index.ts"],
      "@pbd/shared/components/pizza-logo": ["./libs/shared/components/pizza-logo/src/index.ts"],
      "@pbd/shared/models/adress": ["./libs/shared/models/adress/src/index.ts"],
      "@pbd/shared/pipes/catalog-image-url": ["./libs/shared/pipes/catalog-image-url/src/index.ts"],
      "@pbd/shared/components/callout": ["./libs/shared/components/callout/src/index.ts"],
      "@pbd/shared/components/confirm-dialog": [
        "./libs/shared/components/confirm-dialog/src/index.ts"
      ],
      "@pbd/shared/components/empty-state": ["./libs/shared/components/empty-state/src/index.ts"],
      "@pbd/shared/components/hero-banner": ["./libs/shared/components/hero-banner/src/index.ts"],
      "@pbd/shared/components/image-picker": ["./libs/shared/components/image-picker/src/index.ts"],
      "@pbd/shared/components/input": ["./libs/shared/components/input/src/index.ts"],
      "@pbd/shared/components/load-more": ["./libs/shared/components/load-more/src/index.ts"],
      "@pbd/shared/components/modal": ["./libs/shared/components/modal/src/index.ts"],
      "@pbd/shared/components/pagination": ["./libs/shared/components/pagination/src/index.ts"],
      "@pbd/shared/components/photon-location-field": [
        "./libs/shared/components/photon-location-field/src/index.ts"
      ],
      "@pbd/shared/components/spinner": ["./libs/shared/components/spinner/src/index.ts"],
      "@pbd/shared/components/status-badge": ["./libs/shared/components/status-badge/src/index.ts"],
      "@pbd/shared/components/textarea": ["./libs/shared/components/textarea/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
